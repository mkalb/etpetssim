# Ignore Gradle project-specific cache directory
.gradle

# Ignore different build output directories
build/
out/
bin/

# Ignore Kotlin plugin data
.kotlin

# Ignore IntelliJ IDEA, except shared inspection profiles and dictionaries
# (shared run configurations are in /.run; see docs/development/intellij-setup.md)
/.idea/*
!/.idea/dictionaries/
!/.idea/inspectionProfiles/
*.iws
*.iml

# Ignore OS/editor metadata
.DS_Store
Thumbs.db
Desktop.ini

# Ignore Visual Studio Code settings
.vscode/

# Ignore Claude Code personal settings
.claude/settings.local.json

# Ignore the agent review exchange folder
.review/
